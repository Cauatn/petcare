{
	"name": "petcare",
	"private": true,
	"packageManager": "yarn@4.17.1",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo run dev",
		"dev:web": "turbo run dev --filter=@petcare/web",
		"dev:api": "turbo run dev --filter=@petcare/api",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"typecheck": "turbo run typecheck",
		"format": "prettier --write \"apps/**/*.{ts,tsx,json,css,md}\"",
		"docker:up": "docker compose up -d --build",
		"docker:down": "docker compose down"
	},
	"devDependencies": {
		"prettier": "^3.6.2",
		"turbo": "^2.5.8"
	}
}
