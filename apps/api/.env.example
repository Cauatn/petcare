PORT=3333
MONGODB_URI=mongodb://localhost:27017/petcare
# Opcional: se definido, o ESP32 precisa mandar o header "x-device-token"
DEVICE_TOKEN=
CORS_ORIGIN=http://localhost:5173
# Porta UDP da descoberta do ESP32 (fixa em 3333 no firmware; mude só se mudar lá também)
DISCOVERY_PORT=3333
# Opcional: IP do PC na rede local. Em branco = detecta pelas interfaces de rede.
HOST_LAN_IP=
# Fuso da casa (dias e período noturno da aba de saúde)
APP_TIMEZONE=America/Sao_Paulo
